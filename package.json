{
  "name": "tt-loans",
  "version": "1.0.0",
  "private": true,
  "description": "Loan service for the Transport Tycoon FiveM server - in-game User Application + admin approval panel",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create tt-loans",
    "db:init": "wrangler d1 execute tt-loans --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute tt-loans --local --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
